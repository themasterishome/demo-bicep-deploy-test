{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "resources": {
    "st": { "type": "Microsoft.Storage/storageAccounts", "apiVersion": "2023-05-01", "name": "st1" },
    "ownerRole": { "existing": true, "type": "Microsoft.Authorization/roleDefinitions", "apiVersion": "2022-04-01", "name": "8e3af657-a8ff-443c-a75c-2fe8c4bcb635" },
    "governance": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "governance",
      "properties": {
        "mode": "Incremental",
        "template": {
          "resources": [
            { "type": "Microsoft.Authorization/roleAssignments", "apiVersion": "2022-04-01", "name": "[guid('a')]" },
            { "condition": "[parameters('deployLocks')]", "type": "Microsoft.Authorization/locks", "apiVersion": "2020-05-01", "name": "lock1" },
            { "type": "Microsoft.Network/virtualNetworks", "apiVersion": "2024-05-01", "name": "vnet1" }
          ]
        }
      }
    }
  }
}
